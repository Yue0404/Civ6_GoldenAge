    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>
  
  <LocalizedText>
	<Text id="LOC_GOLDENAGE_IP_NAME">
		<en_US>[ICON_GLORY_SUPER_GOLDEN_AGE][COLOR_FLOAT_GOLD]GoldenAge· Infinity Pinnacle[ENDCOLOR]</en_US>
		<zh_Hans_CN>[ICON_GLORY_SUPER_GOLDEN_AGE][COLOR_FLOAT_GOLD]黄金时代·无尽巅峰[ENDCOLOR]</zh_Hans_CN>
	</Text>

	<Text id="LOC_GOLDENAGE_IP_TEASER">
		<en_US>Added a couple of new [COLOR:DiplomaticLabelCS]game play mechanics and personalized perference settings[ENDCOLOR] to make the game more interesting.</en_US>
		<zh_Hans_CN>增添有趣的[COLOR:ResCultureLabelCS]游戏模式与个性化偏好设置[ENDCOLOR]。</zh_Hans_CN>
		<zh_Hant_HK>增添有趣的[COLOR:ResCultureLabelCS]遊戲模式與個性化偏好設置[ENDCOLOR]。</zh_Hant_HK>
	</Text>
	
	<Text id="LOC_GOLDENAGE_IP_AUTHOR">
		<en_US>[COLOR_FLOAT_GOLD]Gold, Flactine, Errt[ENDCOLOR]</en_US>
		<zh_Hans_CN>[COLOR_FLOAT_GOLD]黄小金, 焰色光芒, Errt[ENDCOLOR]</zh_Hans_CN>
		<zh_Hant_HK>[COLOR_FLOAT_GOLD]黃小金, 焰色光芒, Errt[ENDCOLOR]</zh_Hant_HK>
	</Text>
	
	<Text id="LOC_GOLDENAGE_IP_DESCRIPTION">
		<en_US>Added a couple of new [COLOR:DiplomaticLabelCS]game play mechanics and personalized perference settings[ENDCOLOR] to make the game more interesting.</en_US>
		<zh_Hans_CN>增添有趣的[COLOR:ResCultureLabelCS]游戏模式与个性化偏好设置[ENDCOLOR]。</zh_Hans_CN>
		<zh_Hant_HK>增添有趣的[COLOR:ResCultureLabelCS]遊戲模式與個性化偏好設置[ENDCOLOR]。</zh_Hant_HK>
	</Text>
  </LocalizedText>
  
