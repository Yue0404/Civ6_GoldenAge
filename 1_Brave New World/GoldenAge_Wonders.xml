<GameInfo>
    <GlobalParameters>
		<!--奇观旅游业绩（2）-->	
		<Replace Name="TOURISM_BASE_FROM_WONDER" Value="3"/>
	</GlobalParameters>
	
	<Buildings>
		<Update>
	        <Where BuildingType="BUILDING_ST_BASILS_CATHEDRAL"/> <Set PrereqCivic="CIVIC_DIVINE_RIGHT" AdjacentDistrict=""/>
	    </Update> 
		
		<Update>
	        <Where BuildingType="BUILDING_MONT_ST_MICHEL"/> <Set PrereqCivic="CIVIC_REFORMED_CHURCH" ObsoleteEra="ERA_MODERN"/>
	    </Update> 
		<Update>
	        <Where BuildingType="BUILDING_KOTOKU_IN"/> <Set PrereqCivic="CIVIC_REFORMED_CHURCH" ObsoleteEra="ERA_MODERN"/>
	    </Update> 
		<Update>
	        <Where BuildingType="BUILDING_CASA_DE_CONTRATACION"/> <Set PrereqTech=""PrereqCivic="CIVIC_EXPLORATION"/>
	    </Update> 
	</Buildings>
	
	<Building_ValidTerrains>
	    <Row BuildingType="BUILDING_ST_BASILS_CATHEDRAL" TerrainType="TERRAIN_TUNDRA"/>
	</Building_ValidTerrains>
	
	<Building_YieldChanges>
	    <!--大灯塔-->
		<Update>
	        <Where BuildingType="BUILDING_GREAT_LIGHTHOUSE" YieldType="YIELD_GOLD"/> <Set YieldChange="6"/>
	    </Update>
		<!--巨像-->
		<Update>
	        <Where BuildingType="BUILDING_COLOSSUS" YieldType="YIELD_GOLD"/> <Set YieldChange="6"/>
	    </Update>
		<!--马丘比丘-->
		<Delete BuildingType="BUILDING_MACHU_PICCHU" YieldType="YIELD_GOLD" YieldChange="4"/>
	</Building_YieldChanges>
	
	<Building_GreatWorks>
	    <Update>
	        <Where BuildingType="BUILDING_HERMITAGE"/> <Set NumSlots="6" ThemingUniquePerson="false" ThemingSameObjectType="false" ThemingYieldMultiplier="200" ThemingTourismMultiplier="200"/>
	    </Update> 
		<Update>
	        <Where BuildingType="BUILDING_SYDNEY_OPERA_HOUSE"/> <Set NumSlots="4" ThemingUniquePerson="false" ThemingSameObjectType="false" ThemingYieldMultiplier="300" ThemingTourismMultiplier="300"/>
	    </Update> 
		<Row BuildingType="BUILDING_TAJ_MAHAL" GreatWorkSlotType="GREATWORKSLOT_PALACE" NumSlots="3"/>
	</Building_GreatWorks>
	
	<Building_GreatPersonPoints>
	    <!--巨像-->
